# API gateway — the only public entry point
PORT=4000
NODE_ENV=development
# Connect as the non-owner app role so row-level security applies (see db/dev/00-roles.sql)
DATABASE_URL=postgresql://credisync_service:credisync_service_dev@localhost:5432/credisync
# Shared with the gateway; required (32+ chars) outside development
INTERNAL_SERVICE_TOKEN=
# Number of proxy hops in front of this service (1 behind a single ALB)
TRUST_PROXY=0
JWT_SECRET=
# Comma-separated browser origins allowed to call the API with cookies
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Force Secure cookies (defaults to true outside development)
COOKIE_SECURE=
AUTH_SERVICE_URL=http://localhost:4004
BUREAU_INGESTION_URL=http://localhost:4001
DISPUTE_ENGINE_URL=http://localhost:4002
OPEN_BANKING_URL=http://localhost:4003
BANK_READINESS_URL=http://localhost:8000
REDIS_URL=
