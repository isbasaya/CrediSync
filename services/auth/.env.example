# Auth service — signup, login, sessions, consent, POPIA export/erasure
PORT=4004
NODE_ENV=development
# Connect as the non-owner app role so row-level security applies (see db/dev/00-roles.sql)
DATABASE_URL=postgresql://credisync_service:credisync_service_dev@localhost:5432/credisync
# Shared with the gateway; required (32+ chars) outside development
INTERNAL_SERVICE_TOKEN=
# Number of proxy hops in front of this service (1 behind a single ALB)
TRUST_PROXY=0
# Required outside development
JWT_SECRET=
HMAC_KEY=
# 64 hex chars (development only); production uses KMS_KEY_ID instead
ENCRYPTION_MASTER_KEY=
KMS_KEY_ID=
AWS_REGION=af-south-1
# Bump when the privacy notice changes so users re-consent
POPIA_POLICY_VERSION=2026-10-01
WEB_APP_URL=http://localhost:3000
