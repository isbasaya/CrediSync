# Bureau ingestion — TransUnion / Experian / XDS pulls and entity resolution
PORT=4001
NODE_ENV=development
# Connect as the non-owner app role so row-level security applies (see db/dev/00-roles.sql)
DATABASE_URL=postgresql://credisync_service:credisync_service_dev@localhost:5432/credisync
# Shared with the gateway; required (32+ chars) outside development
INTERNAL_SERVICE_TOKEN=
# Number of proxy hops in front of this service (1 behind a single ALB)
TRUST_PROXY=0
ENCRYPTION_MASTER_KEY=
KMS_KEY_ID=
AWS_REGION=af-south-1
# sandbox = synthetic reports (development/test only); omit for real bureaus
BUREAU_MODE=sandbox
BUREAU_REFRESH_COOLDOWN_MS=3600000
# Per-bureau score range for normalisation, e.g. {"experian":[0,999]} — confirm from contracts
BUREAU_SCORE_RANGES=

TRANSUNION_API_BASE_URL=https://api.transunion.co.za
TRANSUNION_API_KEY=
EXPERIAN_API_BASE_URL=https://api.experian.co.za
EXPERIAN_API_KEY=
XDS_API_BASE_URL=https://api.xds.co.za
XDS_API_KEY=
