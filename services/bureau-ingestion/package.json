{
  "name": "@credisync/bureau-ingestion",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-bureau (TransUnion/Experian/XDS) data aggregation and AI entity resolution service",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@credisync/middleware": "*",
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "zod": "^3.23.8",
    "pino": "^9.3.2",
    "@credisync/db": "*",
    "@credisync/crypto": "*",
    "@credisync/types": "*",
    "@credisync/config": "*"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2"
  }
}
