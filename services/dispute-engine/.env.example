# Dispute engine — letters, lifecycle, deadlines, bureau webhooks
PORT=4002
NODE_ENV=development
# Connect as the non-owner app role so row-level security applies (see db/dev/00-roles.sql)
DATABASE_URL=postgresql://credisync_service:credisync_service_dev@localhost:5432/credisync
# Shared with the gateway; required (32+ chars) outside development
INTERNAL_SERVICE_TOKEN=
# Number of proxy hops in front of this service (1 behind a single ALB)
TRUST_PROXY=0
ENCRYPTION_MASTER_KEY=
KMS_KEY_ID=
AWS_REGION=af-south-1
# manual = operations team lodges letters (default); bureau_api once contracted
DISPUTE_SUBMISSION_CHANNEL=manual
DISPUTES_OPS_EMAIL=
# Verified bureau dispute contacts (JSON), see src/templates/legal-references.ts
BUREAU_DISPUTE_CONTACTS=
# Webhook signing secrets, one per bureau (32+ chars outside development)
BUREAU_WEBHOOK_SECRET_TRANSUNION=
BUREAU_WEBHOOK_SECRET_EXPERIAN=
BUREAU_WEBHOOK_SECRET_XDS=
# Evidence uploads (S3, af-south-1, KMS-encrypted); local stub when unset in development
EVIDENCE_BUCKET=
# Local MinIO (development and test only; ignored elsewhere). docker-compose.yml sets these
# for you; the AWS_* credentials below are the compose MinIO dev values.
# S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_ENDPOINT=http://localhost:9000
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
