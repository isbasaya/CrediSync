{
  "name": "@credisync/dispute-engine",
  "version": "0.1.0",
  "private": true,
  "description": "NCA/NCR-compliant credit bureau dispute generation and lifecycle service",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@credisync/middleware": "*",
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "zod": "^3.23.8",
    "pino": "^9.3.2",
    "@credisync/db": "*",
    "@credisync/crypto": "*",
    "@credisync/types": "*",
    "@credisync/config": "*",
    "@credisync/notifications": "*",
    "@credisync/storage": "*",
    "pdfkit": "^0.15.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "@types/pdfkit": "^0.13.4"
  }
}
