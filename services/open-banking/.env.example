# Open banking — Stitch / Ozow ingestion and affordability snapshots
PORT=4003
NODE_ENV=development
# Connect as the non-owner app role so row-level security applies (see db/dev/00-roles.sql)
DATABASE_URL=postgresql://credisync_service:credisync_service_dev@localhost:5432/credisync
# Shared with the gateway; required (32+ chars) outside development
INTERNAL_SERVICE_TOKEN=
# Number of proxy hops in front of this service (1 behind a single ALB)
TRUST_PROXY=0
ENCRYPTION_MASTER_KEY=
KMS_KEY_ID=
AWS_REGION=af-south-1
# sandbox = synthetic transactions (development/test only)
OPEN_BANKING_MODE=sandbox
# NCA affordability expense norms override (JSON), verify against the current gazette
NCA_EXPENSE_NORMS=

# Stitch user-token consent flow (OAuth 2.0 + PKCE). Linking is disabled until these are set.
STITCH_API_BASE_URL=https://api.stitch.money
STITCH_CLIENT_ID=
STITCH_CLIENT_SECRET=
# Must be whitelisted with Stitch; the web app's callback page
STITCH_REDIRECT_URI=https://app.credisync.co.za/bank/callback
OZOW_API_BASE_URL=https://api.ozow.com
OZOW_API_KEY=
OZOW_SITE_CODE=
